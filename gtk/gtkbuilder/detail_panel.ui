<?xml version="1.0" encoding="UTF-8"?>
<interface>
  <requires lib="gtk+" version="3.24"/>
  <object class="GtkBox" id="detail_panel">
    <property name="name">detail_panel</property>
    <property name="visible">1</property>
    <property name="orientation">vertical</property>
    <child>
      <object class="GtkBox">
        <property name="visible">1</property>
        <child>
          <object class="GtkImage" id="icon">
            <property name="visible">1</property>
            <property name="valign">start</property>
            <property name="margin-left">2</property>
            <property name="margin-right">6</property>
            <property name="margin-start">2</property>
            <property name="margin-end">6</property>
            <property name="margin-top">4</property>
            <property name="icon-name">dialog-warning</property>
            <property name="icon-size">2</property>
          </object>
        </child>
        <child>
          <object class="GtkExpander">
            <property name="visible">1</property>
            <property name="can-focus">1</property>
            <property name="margin-top">2</property>
            <child>
              <object class="GtkLabel" id="description">
                <property name="visible">1</property>
                <property name="halign">start</property>
                <property name="margin-left">22</property>
                <property name="margin-start">22</property>
                <property name="margin-bottom">4</property>
                <property name="hexpand">1</property>
                <property name="label" translatable="no"></property>
                <attributes>
                  <attribute name="stretch" value="semi-condensed"/>
                </attributes>
              </object>
            </child>
            <child type="label">
              <object class="GtkLabel" id="title">
                <property name="visible">1</property>
                <property name="margin-left">6</property>
                <property name="margin-start">6</property>
                <property name="margin-bottom">2</property>
                <property name="label" translatable="no"></property>
                <attributes>
                  <attribute name="weight" value="medium"/>
                  <attribute name="stretch" value="semi-condensed"/>
                </attributes>
              </object>
            </child>
          </object>
          <packing>
            <property name="position">1</property>
          </packing>
        </child>
      </object>
    </child>
    <child>
      <object class="GtkSeparator">
        <property name="visible">1</property>
        <property name="margin-top">2</property>
      </object>
      <packing>
        <property name="position">1</property>
      </packing>
    </child>
  </object>
</interface>
