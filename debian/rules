#!/usr/bin/make -f

# make the package build on ubuntu and debian
DIST = $(shell lsb_release -i -s)

DHFLAGS=--parallel
MESON_FLAGS= --prefix=/usr \
	     --localstatedir=/var/lib/synaptic \
	     -Dpkg_hold=true \
	     -Dtests=enabled

%:
	dh $@ $(DHFLAGS) --buildsystem=meson --without autoreconf --without autotools-dev

override_dh_auto_configure:
	dh_auto_configure $(DHFLAGS) -- $(MESON_FLAGS)

override_dh_auto_install:
	dh_auto_install $(DHFLAGS)
