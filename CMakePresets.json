{
  "version": 8,
  "cmakeMinimumRequired": { "major": 4, "minor": 0, "patch": 0 },
  "configurePresets":
  [
    {
      "name": "default",
      "displayName": "Ninja with ccache",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build",
      "installDir": "${sourceDir}/build/stage",
      "cacheVariables":
      {
        "PRESET_NAME": "${presetName}"
      },
      "environment":
      {
        "CCACHE_DIR": "${sourceDir}/build/.ccache"
      }
    }
  ],
  "buildPresets":
  [
    {
      "name": "default",
      "configurePreset": "default"
    }
  ]
}
